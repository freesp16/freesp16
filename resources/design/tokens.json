      "text-2": {
        "$value": "#A8BAC4"
      },
      "text-3": {
        "$value": "#8197A4"
      },
      "accent": {
        "$value": "#52B7FF"
      },
      "accent-weak": {
        "$value": "#214761"
      },
      "on-accent": {
        "$value": "#080C10"
      },
      "mod": {
        "$value": "#FF634E"
      },
      "play": {
        "$value": "#4CE787"
      },
      "rec": {
        "$value": "#FA424C"
      },
      "warn": {
        "$value": "#FFB644"
      },
      "playhead": {
        "$value": "#FFFFFF"
      },
      "meter-low": {
        "$value": "#47D69E"
      },
      "meter-mid": {
        "$value": "#FFBD45"
      },
      "meter-high": {
        "$value": "#FF5157"
      }
    },
    "light": {
