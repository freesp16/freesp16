{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "sixteen-ui",
    "version": "1.0.0",
    "canvas": {
      "width": 1280,
      "height": 768,
      "unit": "lpx"
    }
  },
  "color": {
    "dark": {
      "bg": {
        "$value": "#0B0D10",
        "$description": "app background, behind everything"
      },
      "surface-1": {
        "$value": "#13161B",
        "$description": "regions: context bar, knob strip, rails"
      },
      "surface-2": {
        "$value": "#1A1E25",
        "$description": "cards, tiles, buttons at rest"
      },
      "surface-3": {
        "$value": "#232833",
        "$description": "hover/pressed, popup bodies, list zebra"
      },
      "overlay": {
        "$value": "#0B0D10B8",
        "$description": "scrim behind modals (72 % alpha)"
      },
      "border": {
        "$value": "#2A303B"
      },
      "border-strong": {
        "$value": "#3A4250"
      },
      "text-1": {
        "$value": "#E8ECF2",
        "$description": "values, titles (15.3:1 on surface-1)"
      },
      "text-2": {
        "$value": "#A3ACBA",
        "$description": "captions, labels (7.9:1)"
      },
      "text-3": {
        "$value": "#6B7482",
        "$description": "disabled, hints (3.8:1, non-essential only)"
      },
      "accent": {
        "$value": "#569DFF",
        "$description": "focus ring, selection, active toggle"
      },
      "accent-weak": {
        "$value": "#569DFF29",
        "$description": "selected row/segment fill (16 %)"
      },
      "on-accent": {
        "$value": "#0B0D10"
      },
      "mod": {
        "$value": "#FE6270",
        "$description": "lockable/modulatable marker, locked value"
      },
      "play": {
        "$value": "#4ADD8C"
      },
      "rec": {
        "$value": "#F53C41"
      },
      "warn": {
        "$value": "#F7B83D",
        "$description": "clip / OVER / caution"
      },
      "meter-low": {
        "$value": "#4ADD8C"
      },
      "meter-mid": {
        "$value": "#F7B83D",
        "$description": "above -6 dBFS"
      },
      "meter-high": {
        "$value": "#F53C41",
        "$description": "above -1 dBFS / clip"
      },
      "playhead": {
        "$value": "#FFFFFF"
      }
    },
    "classic": {
      "bg": {
        "$value": "#080B0D"
      },
      "surface-1": {
        "$value": "#101517"
      },
      "surface-2": {
        "$value": "#1C2226"
      },
      "surface-3": {
        "$value": "#303A40"
      },
      "overlay": {
        "$value": "#04070BC7"
