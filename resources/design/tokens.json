    "scene": {
      "$description": "Scene n uses track colour n by default (scene colours are editable since 1.40)."
    }
  },
  "font": {
    "family": {
      "ui": {
        "$value": "Inter, 'SF Pro Text', system-ui, sans-serif"
      },
      "mono": {
        "$value": "'JetBrains Mono', ui-monospace, monospace"
      }
    },
    "feature": {
      "values": {
        "$value": "tnum, ss01",
        "$description": "tabular numerals for every changing number"
      }
    },
    "style": {
      "caption": {
        "size": 11,
        "line": 14,
        "weight": 600,
        "tracking": 0.06,
        "case": "upper"
      },
      "label": {
        "size": 13,
        "line": 16,
        "weight": 600,
        "tracking": 0.04,
        "case": "upper"
      },
      "body": {
        "size": 15,
        "line": 20,
        "weight": 400
      },
      "body-strong": {
        "size": 15,
        "line": 20,
        "weight": 600
      },
      "title": {
        "size": 17,
        "line": 22,
        "weight": 600
      },
      "value-s": {
        "size": 17,
        "line": 22,
        "weight": 500,
        "features": "tnum"
      },
      "value": {
        "size": 24,
        "line": 28,
        "weight": 500,
        "features": "tnum"
      },
      "value-l": {
        "size": 32,
        "line": 36,
        "weight": 500,
        "features": "tnum"
      },
      "display": {
        "size": 56,
        "line": 60,
        "weight": 300,
        "features": "tnum"
      }
    }
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48,
    "8": 64
  },
  "radius": {
    "xs": 4,
    "s": 6,
    "m": 8,
    "l": 12,
    "pill": 999
  },
  "border": {
    "hairline": 1,
    "focus": 2,
    "track-frame": 2
  },
  "elevation": {
    "0": {
      "$value": "none"
    },
    "1": {
      "$value": "0 1px 0 #00000040"
    },
    "2": {
      "$value": "0 8px 24px #00000066, 0 0 0 1px #2A303B",
      "$description": "popups and modals"
    }
  },
  "motion": {
    "instant": {
      "duration": 0
    },
    "fast": {
      "duration": 90,
      "easing": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "base": {
      "duration": 160,
      "easing": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "slow": {
      "duration": 240,
      "easing": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "meter-release": {
      "duration": 300,
      "$description": "peak fall per 20 dB"
    },
    "peak-hold": {
      "duration": 500
    },
    "pad-flash": {
      "duration": 1000,
      "$description": "pad hit flash decay"
    },
    "blink-slow": {
      "period": 1000,
      "$description": "1 Hz on/off, 50 % duty: armed, standby"
    },
    "blink-fast": {
      "period": 500,
      "$description": "2 Hz: pending switch, recording"
    }
  },
  "size": {
    "hit-min": 44,
    "icon": 24,
    "icon-s": 16,
    "focus-ring-offset": 2,
    "status-row": 40,
    "context-bar": 96,
    "knob-strip": 144,
    "rail": 192
  }
}
